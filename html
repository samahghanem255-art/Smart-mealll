<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Meal</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const supa = supabase.createClient('https://xvghguxdgezhiowswvsd.supabase.co','sb_publishable_Sk-ark6LufVu-zOWxf6Ozg_ecumaQvG');
</script>
<style>
body{font-family:Tahoma;background:#f9f9f9;margin:0;padding:0}
header{background:#111;color:#fff;padding:15px;display:flex;justify-content:space-between;align-items:center}
.card{background:#fff;margin:15px;padding:15px;border-radius:10px;box-shadow:0 2px 5px rgba(0,0,0,.1)}
button{background:#111;color:#fff;border:0;padding:10px 15px;border-radius:6px;cursor:pointer}
input,textarea{width:100%;padding:10px;margin:6px 0;border:1px solid #ccc;border-radius:6px;box-sizing:border-box}
#cart{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:center;justify-content:center;z-index:99}
#cart.show{display:flex}
.box{background:#fff;padding:20px;border-radius:12px;width:90%;max-width:380px}
</style>
</head>
<body>
<header>
<strong>Smart Meal</strong>
<button onclick="document.getElementById('cart').classList.add('show')">🛒 <span id="cnt">0</span></button>
</header>

<div class="card"><h3>دجاج مشوي</h3><p>450 دج</p><button onclick="add('دجاج مشوي',450)">أضف للسلة</button></div>
<div class="card"><h3>وجبة أرز</h3><p>450 دج</p><button onclick="add('وجبة أرز',450)">أضف للسلة</button></div>
<div class="card"><h3>باستا</h3><p>450 دج</p><button onclick="add('باستا',450)">أضف للسلة</button></div>

<div class="card">
<h3>معلوماتك</h3>
<input id="nom" placeholder="اسمك">
<input id="tel" placeholder="هاتفك">
<textarea id="adr" placeholder="عنوانك"></textarea>
<button onclick="send()" style="width:100%">ادفع الآن - <span id="tot">0</span> دج</button>
</div>

<div id="cart"><div class="box">
<button onclick="document.getElementById('cart').classList.remove('show')">✕ إغلاق</button>
<h3>السلة</h3>
<div id="items">فارغة</div>
<p>المجموع: <b id="tot2">0</b> دج</p>
<button onclick="send()" style="width:100%">تأكيد الطلب</button>
</div></div>

<script>
let list=[];
function add(name,price){
 list.push({name,price});
 let t=0; list.forEach(i=>t+=i.price);
 document.getElementById('cnt').innerText=list.length;
 document.getElementById('tot').innerText=t;
 document.getElementById('tot2').innerText=t;
 let h=''; list.forEach(i=>h+='<p>'+i.name+' - '+i.price+' دج</p>');
 document.getElementById('items').innerHTML=h;
 document.getElementById('cart').classList.add('show');
}
async function send(){
 let nom=document.getElementById('nom').value;
 let telephone=document.getElementById('tel').value;
 let adresse=document.getElementById('adr').value;
 let prix=parseInt(document.getElementById('tot').innerText)||0;
 if(!nom||!telephone){alert('اكتب اسمك وهاتفك');return}
 let d=new Date();
 let {error}=await supa.from('meal_orders').insert([{nom,telephone,adresse,prix,date_commande:d.toISOString().split('T')[0],heure:d.toLocaleTimeString()}]);
 if(error){alert(error.message)}else{alert('✅ تم الطلب بنجاح');list=[];document.getElementById('cnt').innerText='0';document.getElementById('cart').classList.remove('show')}
}
</script>
</body>
</html>
